@{
    ViewData["Title"] = "Giới thiệu Đại lý Yamaha Town Việt-Hung";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active">Giới thiệu đại lý</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6">
                <span class="badge bg-danger mb-2">ĐẠI LÝ ỦY QUYỀN 3S CHÍNH HÃNG</span>
                <h2 class="fw-bold text-dark">CHÀO MỪNG ĐẾN VỚI YAMAHA TOWN VIỆT-HUNG</h2>
                <p class="text-secondary">
                    Yamaha Town Việt-Hung là đại lý ủy quyền tiêu chuẩn 3S (Sales - Service - Spare parts) chính thức của Yamaha Motor Việt Nam. Với sứ mệnh mang lại tinh thần <em>"Revs Your Heart" - Khơi dậy đam mê</em> cho mọi khách hàng yêu xe máy tại Việt Nam.
                </p>
                <div class="row g-3 mt-2">
                    <div class="col-sm-4 text-center p-3 bg-light rounded-3">
                        <h3 class="fw-bold text-danger mb-0">100%</h3>
                        <small class="text-muted">Chính hãng Yamaha</small>
                    </div>
                    <div class="col-sm-4 text-center p-3 bg-light rounded-3">
                        <h3 class="fw-bold text-primary mb-0">3 Năm</h3>
                        <small class="text-muted">Bảo hành tiêu chuẩn</small>
                    </div>
                    <div class="col-sm-4 text-center p-3 bg-light rounded-3">
                        <h3 class="fw-bold text-success mb-0">9 Lần</h3>
                        <small class="text-muted">Bảo dưỡng miễn phí</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <img src="/images/banners/slider-1.jpg" alt="Showroom Yamaha Town" class="img-fluid rounded-3 shadow"
                     onerror="this.src='https://placehold.co/600x380/0b2265/ffffff?text=SHOWROOM+YAMAHA+TOWN';" />
            </div>
        </div>

        <div class="row g-4 border-top pt-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100 text-center">
                    <i class="bi bi-shop text-danger fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold">1. Bán hàng (Sales)</h5>
                    <p class="small text-muted mb-0">Cung cấp tất cả các dòng xe tay ga, xe số, xe thể thao côn tay và xe điện mới nhất với mức giá cạnh tranh nhất.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100 text-center">
                    <i class="bi bi-tools text-primary fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold">2. Dịch vụ (Service)</h5>
                    <p class="small text-muted mb-0">Đội ngũ kỹ thuật viên tay nghề cao được đào tạo bài bản theo quy trình tiêu chuẩn Nhật Bản của Yamaha Motor.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 h-100 text-center">
                    <i class="bi bi-gear-wide-connected text-success fs-1 mb-2 d-block"></i>
                    <h5 class="fw-bold">3. Phụ tùng (Spare Parts)</h5>
                    <p class="small text-muted mb-0">Cam kết 100% linh kiện, phụ tùng và dầu nhớt Yamalube chính hãng, bảo đảm hiệu suất xe vận hành tối ưu.</p>
                </div>
            </div>
        </div>
    </div>
</div>
