@model YamahaStoreWeb.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ - Đại lý Xe máy Yamaha Town Chính Hãng";
}

<div class="container">
    <div class="row g-4">
        <!-- ================= CỘT TRÁI: MENU DỌC, BỘ LỌC, QUẢNG CÁO, THỐNG KÊ (YÊU CẦU MỤC 2.b & 2.d) ================= -->
        <div class="col-lg-3 col-md-4">
            <!-- 1. MENU DỌC: DANH MỤC SẢN PHẨM (Mục 2.b) -->
            <div class="menu-doc-card mb-4 bg-white">
                <div class="menu-doc-header d-flex align-items-center">
                    <i class="bi bi-grid-fill me-2 fs-5"></i>
                    <span>DANH MỤC DÒNG XE</span>
                </div>
                <div class="list-group list-group-flush menu-doc-list">
                    @foreach (var dm in Model.DanhMucs)
                    {
                        <a asp-controller="XeMay" asp-action="Index" asp-route-maDanhMuc="@dm.MaDanhMuc" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center text-decoration-none">
                            <span><i class="bi @(string.IsNullOrEmpty(dm.Icon) ? "bi-chevron-right" : dm.Icon) me-2 text-danger"></i> @dm.TenDanhMuc</span>
                            <span class="badge bg-light text-dark rounded-pill border">Xem</span>
                        </a>
                    }
                </div>
            </div>

            <!-- 2. BỘ LỌC KHOẢNG GIÁ NHANH -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white fw-bold text-dark py-3 border-bottom">
                    <i class="bi bi-funnel-fill text-danger me-2"></i> KHOẢNG GIÁ BÁN
                </div>
                <div class="card-body p-3">
                    <div class="d-flex flex-column gap-2 small">
                        <a asp-controller="XeMay" asp-action="Index" asp-route-khoangGia="duoi-30" 
                           class="btn btn-outline-secondary btn-sm text-start py-2">
                            <i class="bi bi-tag me-1 text-danger"></i> Dưới 30 triệu VNĐ
                        </a>
                        <a asp-controller="XeMay" asp-action="Index" asp-route-khoangGia="30-50" 
                           class="btn btn-outline-secondary btn-sm text-start py-2">
                            <i class="bi bi-tag me-1 text-primary"></i> Từ 30 - 50 triệu VNĐ
                        </a>
                        <a asp-controller="XeMay" asp-action="Index" asp-route-khoangGia="tren-50" 
                           class="btn btn-outline-secondary btn-sm text-start py-2">
                            <i class="bi bi-tag me-1 text-success"></i> Trên 50 triệu VNĐ
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3. HỆ THỐNG QUẢNG CÁO ĐI KÈM (MỤC 2.d - TIÊU CHÍ ĐIỂM GIỎI) -->
            <div class="ad-section mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-uppercase text-muted"><i class="bi bi-megaphone-fill text-danger me-1"></i> Ưu đãi đặc quyền</span>
                    <span class="badge bg-danger">HOT</span>
                </div>
                <div class="d-flex flex-column gap-3">
                    @if (Model.QuangCaoSidebar.Any())
                    {
                        @foreach (var qc in Model.QuangCaoSidebar)
                        {
                            <div class="ad-banner-card">
                                <a href="@(string.IsNullOrEmpty(qc.LinkLienKet) ? "/DangKy" : qc.LinkLienKet)" title="@qc.TieuDe">
                                    <img src="@qc.HinhAnhBanner" alt="@qc.TieuDe" class="img-fluid" 
                                         onerror="this.src='https://placehold.co/320x180/0b2265/ffffff?text=@Uri.EscapeDataString(qc.TieuDe)';" />
                                    <span class="ad-badge">QUẢNG CÁO</span>
                                </a>
                                <div class="p-2 small fw-bold text-dark text-center bg-white border-top">
                                    @qc.TieuDe
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Quảng cáo mặc định nếu chưa thêm trong DB -->
                        <div class="ad-banner-card">
                            <a asp-controller="DangKy" asp-action="Index">
                                <img src="/images/ads/banner-tra-gop.png" alt="Trả góp 0%" class="img-fluid"
                                     onerror="this.src='https://placehold.co/320x180/d32f2f/ffffff?text=TRA+GOP+0%+YAMAHA';" />
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. THỐNG KÊ TRUY CẬP (YÊU CẦU MỤC 2.b) -->
            <div class="thong-ke-box">
                <div class="fw-bold text-dark border-bottom pb-2 mb-3 d-flex align-items-center">
                    <i class="bi bi-bar-chart-line-fill text-danger me-2 fs-5"></i>
                    <span>THỐNG KÊ TRUY CẬP</span>
                </div>
                <div class="thong-ke-item">
                    <span class="text-secondary"><i class="bi bi-person-fill text-success me-2"></i> Đang online:</span>
                    <span class="counter-badge bg-success">@Model.SoNguoiOnline</span>
                </div>
                <div class="thong-ke-item">
                    <span class="text-secondary"><i class="bi bi-eye-fill text-primary me-2"></i> Tổng lượt truy cập:</span>
                    <span class="counter-badge">@Model.TongLuotTruyCap.ToString("N0")</span>
                </div>
                <div class="thong-ke-item">
                    <span class="text-secondary"><i class="bi bi-calendar2-check me-2"></i> Cập nhật:</span>
                    <span class="small text-muted">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <!-- ================= CỘT PHẢI: BANNER SLIDER, SẢN PHẨM BÁN CHẠY, SẢN PHẨM MỚI (MỤC 2.c & 2.d) ================= -->
        <div class="col-lg-9 col-md-8">
            <!-- 1. HERO BANNER SLIDER CHÍNH -->
            <div id="yamahaHeroCarousel" class="carousel slide rounded-3 overflow-hidden shadow-sm mb-4" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#yamahaHeroCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#yamahaHeroCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#yamahaHeroCarousel" data-bs-slide-to="2"></button>
                </div>
                <div class="carousel-inner" style="max-height: 380px;">
                    <div class="carousel-item active" data-bs-interval="4000">
                        <img src="/images/banners/slider-1.jpg" class="d-block w-100" alt="Yamaha Exciter 155 VVA"
                             onerror="this.src='https://placehold.co/900x380/0b2265/ffffff?text=YAMAHA+EXCITER+155+VVA+-+ONG+VUA+DUONG+PHO';" />
                        <div class="carousel-caption d-none d-md-block text-start bg-dark bg-opacity-75 p-3 rounded-3" style="max-width: 480px;">
                            <span class="badge bg-danger mb-1">MỚI RA MẮT 2025</span>
                            <h4 class="fw-bold text-white mb-1">YAMAHA EXCITER 155 VVA ABS</h4>
                            <p class="small mb-2">Động cơ 155cc van biến thiên mạnh mẽ, phanh ABS an toàn tuyệt đối.</p>
                            <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="yamaha-exciter-155-vva-abs" class="btn btn-danger btn-sm">Xem chi tiết & Báo giá</a>
                        </div>
                    </div>
                    <div class="carousel-item" data-bs-interval="4000">
                        <img src="/images/banners/slider-2.jpg" class="d-block w-100" alt="Yamaha Grande Hybrid"
                             onerror="this.src='https://placehold.co/900x380/cc0000/ffffff?text=YAMAHA+GRANDE+BLUE+CORE+HYBRID+-+TOP+1+TIET+KIEM+XANG';" />
                        <div class="carousel-caption d-none d-md-block text-start bg-dark bg-opacity-75 p-3 rounded-3" style="max-width: 480px;">
                            <span class="badge bg-warning text-dark mb-1">TIẾT KIỆM XĂNG SỐ 1</span>
                            <h4 class="fw-bold text-white mb-1">YAMAHA GRANDE HYBRID</h4>
                            <p class="small mb-2">Trợ lực điện Hybrid êm ái, cốp 27L rộng rãi, chỉ 1.66 lít/100km.</p>
                            <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="yamaha-grande-blue-core-hybrid" class="btn btn-warning btn-sm text-dark fw-bold">Khám phá ngay</a>
                        </div>
                    </div>
                    <div class="carousel-item" data-bs-interval="4000">
                        <img src="/images/banners/slider-3.jpg" class="d-block w-100" alt="Lái thử xe nhận quà"
                             onerror="this.src='https://placehold.co/900x380/1a1a1a/ffd700?text=DANG+KY+LAI+THU+XE+YAMAHA+2025';" />
                        <div class="carousel-caption d-none d-md-block text-start bg-dark bg-opacity-75 p-3 rounded-3" style="max-width: 480px;">
                            <span class="badge bg-success mb-1">TRẢI NGHIỆM MIỄN PHÍ</span>
                            <h4 class="fw-bold text-white mb-1">ĐĂNG KÝ LÁI THỬ TẠI SHOWROOM</h4>
                            <p class="small mb-2">Trải nghiệm thực tế các dòng xe Exciter 155, NVX, Grande, R15 trước khi mua.</p>
                            <a asp-controller="DangKy" asp-action="Index" class="btn btn-light btn-sm fw-bold">Đặt lịch ngay</a>
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#yamahaHeroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#yamahaHeroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

            <!-- ================= 2. KHU VỰC SẢN PHẨM BÁN CHẠY (YÊU CẦU MỤC 2.c - ĐẠT MỨC KHÁ) ================= -->
            <div class="mb-5">
                <div class="section-header">
                    <div>
                        <h3 class="section-title title-banchay">
                            <i class="bi bi-fire text-danger me-2"></i> SẢN PHẨM BÁN CHẠY
                        </h3>
                        <small class="text-muted">Các mẫu xe Yamaha được đông đảo khách hàng tin dùng và bán chạy nhất</small>
                    </div>
                    <a asp-controller="XeMay" asp-action="Index" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="row g-3">
                    @foreach (var xe in Model.XeBanChay)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6">
                            <div class="product-card">
                                <!-- Badge Bán chạy (Mục 2.c) -->
                                <span class="badge-banchay"><i class="bi bi-star-fill me-1"></i> BÁN CHẠY</span>
                                @if (xe.IsMoiVe)
                                {
                                    <span class="badge-moive"><i class="bi bi-lightning-fill"></i> MỚI</span>
                                }
                                <div class="product-img-wrapper">
                                    <img src="@xe.HinhAnh" alt="@xe.TenXe" 
                                         onerror="this.src='https://placehold.co/300x200/f1f5f9/0b2265?text=@Uri.EscapeDataString(xe.TenXe)';" />
                                </div>
                                <div class="product-body">
                                    <span class="product-category">@(xe.DanhMuc?.TenDanhMuc ?? "Yamaha Motor")</span>
                                    <h5 class="product-title" title="@xe.TenXe">
                                        <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="@xe.Slug" class="text-decoration-none text-dark">
                                            @xe.TenXe
                                        </a>
                                    </h5>
                                    <div class="product-specs d-flex justify-content-between">
                                        <span><i class="bi bi-speedometer2 me-1"></i> @xe.PhanKhoi</span>
                                        <span><i class="bi bi-palette me-1"></i> @xe.MauSac.Split(',')[0]</span>
                                    </div>
                                    <div class="d-flex align-items-baseline mb-3">
                                        <span class="product-price">@xe.GiaBan.ToString("N0") đ</span>
                                        @if (xe.GiaKhuyenMai.HasValue && xe.GiaKhuyenMai > 0)
                                        {
                                            <span class="product-old-price">@xe.GiaKhuyenMai.Value.ToString("N0") đ</span>
                                        }
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="@xe.Slug" 
                                           class="btn btn-outline-danger btn-sm flex-grow-1">
                                            Chi tiết
                                        </a>
                                        <a asp-controller="DangKy" asp-action="Index" asp-route-maXe="@xe.MaXe" 
                                           class="btn btn-danger btn-sm" title="Đăng ký lái thử">
                                            <i class="bi bi-calendar-check"></i> Lái thử
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ================= 3. QUẢNG CÁO GIỮA TRANG (YÊU CẦU MỤC 2.d - ĐIỂM GIỎI) ================= -->
            @if (Model.QuangCaoMid.Any())
            {
                <div class="mb-5">
                    @foreach (var qc in Model.QuangCaoMid)
                    {
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                            <a href="@(string.IsNullOrEmpty(qc.LinkLienKet) ? "/DangKy" : qc.LinkLienKet)" class="d-block position-relative">
                                <img src="@qc.HinhAnhBanner" alt="@qc.TieuDe" class="w-100" style="max-height: 180px; object-fit: cover;"
                                     onerror="this.src='https://placehold.co/900x180/cc0000/ffffff?text=@Uri.EscapeDataString(qc.TieuDe)';" />
                                <span class="ad-badge">CHƯƠNG TRÌNH KHUYẾN MÃI</span>
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- ================= 4. KHU VỰC XE MỚI VỀ & ĐA DẠNG DÒNG XE ================= -->
            <div class="mb-5">
                <div class="section-header">
                    <div>
                        <h3 class="section-title">
                            <i class="bi bi-lightning-charge-fill text-warning me-2"></i> XE MỚI VỀ SHOWROOM
                        </h3>
                        <small class="text-muted">Các phiên bản mới nhất cập nhật trong năm 2025</small>
                    </div>
                    <a asp-controller="XeMay" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Xem tất cả <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="row g-3">
                    @foreach (var xe in Model.XeMoiVe)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6">
                            <div class="product-card">
                                <span class="badge-moive"><i class="bi bi-stars"></i> MỚI 2025</span>
                                <div class="product-img-wrapper">
                                    <img src="@xe.HinhAnh" alt="@xe.TenXe" 
                                         onerror="this.src='https://placehold.co/300x200/f1f5f9/0b2265?text=@Uri.EscapeDataString(xe.TenXe)';" />
                                </div>
                                <div class="product-body">
                                    <span class="product-category">@(xe.DanhMuc?.TenDanhMuc ?? "Yamaha Motor")</span>
                                    <h5 class="product-title" title="@xe.TenXe">
                                        <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="@xe.Slug" class="text-decoration-none text-dark">
                                            @xe.TenXe
                                        </a>
                                    </h5>
                                    <div class="product-specs d-flex justify-content-between">
                                        <span><i class="bi bi-speedometer2 me-1"></i> @xe.PhanKhoi</span>
                                        <span><i class="bi bi-eye me-1"></i> @xe.LuotXem lượt xem</span>
                                    </div>
                                    <div class="d-flex align-items-baseline mb-3">
                                        <span class="product-price">@xe.GiaBan.ToString("N0") đ</span>
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-controller="XeMay" asp-action="ChiTiet" asp-route-slug="@xe.Slug" 
                                           class="btn btn-outline-danger btn-sm flex-grow-1">Chi tiết</a>
                                        <a asp-controller="DangKy" asp-action="Index" asp-route-maXe="@xe.MaXe" 
                                           class="btn btn-danger btn-sm"><i class="bi bi-calendar-check"></i> Lái thử</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ================= 5. TIN TỨC & KHUYẾN MÃI ================= -->
            <div class="mb-4">
                <div class="section-header">
                    <div>
                        <h3 class="section-title">
                            <i class="bi bi-newspaper text-primary me-2"></i> TIN TỨC & SỰ KIỆN YAMAHA
                        </h3>
                        <small class="text-muted">Cập nhật tin tức thị trường xe máy, ưu đãi và hướng dẫn bảo dưỡng</small>
                    </div>
                </div>

                <div class="row g-3">
                    @foreach (var tin in Model.TinTucs)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                                <div class="bg-light text-center p-2" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                                    <img src="@tin.HinhAnh" class="img-fluid" alt="@tin.TieuDe" style="max-height: 160px; object-fit: contain;"
                                         onerror="this.src='/images/products/exciter-155.png';" />
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <small class="text-muted d-block mb-1"><i class="bi bi-calendar3 me-1"></i> @tin.NgayDang.ToString("dd/MM/yyyy")</small>
                                    <h6 class="fw-bold mb-2" style="height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        <a asp-controller="TinTuc" asp-action="ChiTiet" asp-route-slug="@tin.Slug" class="text-dark text-decoration-none">
                                            @tin.TieuDe
                                        </a>
                                    </h6>
                                    <p class="small text-secondary mb-3" style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @tin.TomTat
                                    </p>
                                    <div class="mt-auto">
                                        <a asp-controller="TinTuc" asp-action="ChiTiet" asp-route-slug="@tin.Slug" class="small text-danger fw-bold text-decoration-none">
                                            Đọc tiếp <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
