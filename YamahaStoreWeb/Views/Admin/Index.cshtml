@model List<YamahaStoreWeb.Models.DangKyLaiThu>
@{
    ViewData["Title"] = "Bảng điều khiển Quản trị viên Yamaha";
    Layout = "_Layout";
}

<div class="container">
    <!-- Header Admin -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-speedometer2 text-danger me-2"></i> BẢNG ĐIỀU KHIỂN QUẢN TRỊ (ADMIN)</h3>
            <span class="text-muted small">Xin chào, <strong>@(Context.Session.GetString("AdminName") ?? "Quản trị viên")</strong> | Phiên làm việc CMS</span>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="ThemXe" class="btn btn-danger btn-sm fw-bold">
                <i class="bi bi-plus-circle me-1"></i> Thêm xe máy mới
            </a>
            <a asp-action="ThemQuangCao" class="btn btn-primary btn-sm fw-bold">
                <i class="bi bi-megaphone me-1"></i> Thêm Banner QC (2.d)
            </a>
            <a asp-action="Logout" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 4 Khối Thống kê nghiệp vụ -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-sm-6">
            <div class="card admin-card-stat bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Tổng số mẫu xe</div>
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TongSoXe</h2>
                    </div>
                    <div class="icon-circle bg-danger bg-opacity-10 text-danger fs-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-bicycle"></i>
                    </div>
                </div>
                <a asp-action="XeMay" class="small text-danger text-decoration-none fw-bold mt-2 d-block">
                    Quản lý danh sách xe <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card admin-card-stat bg-white p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Dòng xe (Menu dọc)</div>
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TongDanhMuc</h2>
                    </div>
                    <div class="icon-circle bg-primary bg-opacity-10 text-primary fs-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-grid-fill"></i>
                    </div>
                </div>
                <span class="small text-muted mt-2 d-block">Xe ga, xe số, côn tay, xe điện</span>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card admin-card-stat bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Banner Quảng cáo (2.d)</div>
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TongQuangCao</h2>
                    </div>
                    <div class="icon-circle bg-warning bg-opacity-10 text-warning fs-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-megaphone-fill"></i>
                    </div>
                </div>
                <a asp-action="QuangCao" class="small text-warning text-decoration-none fw-bold mt-2 d-block">
                    Quản lý hệ thống banner <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="card admin-card-stat bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Khách Đăng ký lái thử</div>
                        <h2 class="fw-bold text-dark mb-0">@ViewBag.TongDangKy</h2>
                    </div>
                    <div class="icon-circle bg-success bg-opacity-10 text-success fs-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <a asp-action="DangKy" class="small text-success text-decoration-none fw-bold mt-2 d-block">
                    Xem danh sách khách <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Thanh Menu Điều hướng nhanh Admin -->
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="XeMay" class="btn btn-outline-danger fw-bold btn-sm">
                <i class="bi bi-speedometer me-1"></i> Quản lý Sản phẩm Xe Máy (Mục 2.a & 2.c)
            </a>
            <a asp-action="QuangCao" class="btn btn-outline-primary fw-bold btn-sm">
                <i class="bi bi-badge-ad-fill me-1"></i> Quản lý Hệ thống Quảng cáo (Mục 2.d - Điểm Giỏi)
            </a>
            <a asp-action="DangKy" class="btn btn-outline-success fw-bold btn-sm">
                <i class="bi bi-person-lines-fill me-1"></i> Danh sách Đăng ký Lái thử & Tư vấn
            </a>
            <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-dark fw-bold btn-sm ms-auto">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem trang Client
            </a>
        </div>
    </div>

    <!-- Bảng Khách hàng mới đăng ký lái thử gần nhất -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-history text-danger me-2"></i> YÊU CẦU ĐĂNG KÝ LÁI THỬ MỚI NHẤT
            </h5>
            <a asp-action="DangKy" class="btn btn-outline-secondary btn-sm">Xem tất cả</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Dòng xe quan tâm</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var dk in Model)
                        {
                            <tr>
                                <td class="fw-bold">@dk.HoTen</td>
                                <td><span class="badge bg-light text-dark border">@dk.SoDienThoai</span></td>
                                <td>@(string.IsNullOrEmpty(dk.Email) ? "-" : dk.Email)</td>
                                <td class="text-danger fw-bold">@(dk.XeMay?.TenXe ?? "Chung các dòng")</td>
                                <td>@dk.NgayGui.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(dk.TrangThai == "Hoàn tất" ? "bg-success" : dk.TrangThai == "Đã liên hệ" ? "bg-primary" : "bg-warning text-dark")">
                                        @dk.TrangThai
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="CapNhatTrangThaiDangKy" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@dk.MaDK" />
                                        <input type="hidden" name="trangThai" value="Đã liên hệ" />
                                        <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Xác nhận đã gọi">
                                            <i class="bi bi-telephone"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">Chưa có yêu cầu đăng ký nào mới.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
