@model YamahaStoreWeb.Models.XeMay
@{
    ViewData["Title"] = "Chỉnh sửa thông tin xe: " + Model.TenXe;
    Layout = "_Layout";
    var danhMucs = ViewBag.DanhMucs as List<YamahaStoreWeb.Models.DanhMuc> ?? new List<YamahaStoreWeb.Models.DanhMuc>();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-primary me-2"></i> CHỈNH SỬA XE: @Model.TenXe</h3>
            <span class="text-muted small">Cập nhật thông số, giá bán và cấu hình hiển thị</span>
        </div>
        <a asp-action="XeMay" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách xe
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <form asp-action="SuaXe" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaXe" />
            <input type="hidden" asp-for="Slug" />
            <input type="hidden" asp-for="LuotXem" />
            <input type="hidden" asp-for="NgayTao" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Tên mẫu xe <span class="text-danger">*</span></label>
                    <input asp-for="TenXe" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Dòng xe (Danh mục) <span class="text-danger">*</span></label>
                    <select asp-for="MaDanhMuc" class="form-select" required>
                        @foreach (var dm in danhMucs)
                        {
                            <option value="@dm.MaDanhMuc" selected="@(Model.MaDanhMuc == dm.MaDanhMuc)">@dm.TenDanhMuc</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Giá bán đề xuất (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="GiaBan" type="number" class="form-control" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Giá khuyến mãi (nếu có)</label>
                    <input asp-for="GiaKhuyenMai" type="number" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Phân khối <span class="text-danger">*</span></label>
                    <input asp-for="PhanKhoi" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Màu sắc có sẵn <span class="text-danger">*</span></label>
                    <input asp-for="MauSac" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Đường dẫn hình ảnh</label>
                    <input asp-for="HinhAnh" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small">Thông số kỹ thuật chi tiết</label>
                    <textarea asp-for="ThongSoKT" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small">Mô tả bài viết</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsBanChay" id="switchBanChay">
                        <label class="form-check-label fw-bold text-danger" for="switchBanChay">
                            <i class="bi bi-fire me-1"></i> Đánh dấu là Sản phẩm bán chạy (Mục 2.c - Tiêu chí Khá)
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsMoiVe" id="switchMoiVe">
                        <label class="form-check-label fw-bold text-success" for="switchMoiVe">
                            <i class="bi bi-lightning-charge me-1"></i> Đánh dấu là Xe mới về 2025
                        </label>
                    </div>
                </div>

                <div class="col-12 text-end mt-4">
                    <a asp-action="XeMay" class="btn btn-secondary me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-save me-1"></i> Cập nhật thay đổi
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
