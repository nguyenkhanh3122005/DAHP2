@{
    ViewData["Title"] = "Đăng nhập Hệ thống Quản trị Yamaha";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
                <div class="bg-yamaha-blue p-4 text-center text-white">
                    <span class="brand-text-yamaha fs-3 text-white d-block mb-1">YAMAHA</span>
                    <h5 class="fw-bold mb-0">HỆ THỐNG QUẢN TRỊ CMS</h5>
                    <small class="text-white-50">Cửa hàng xe máy Yamaha Town</small>
                </div>
                <div class="card-body p-4 bg-white">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Tài khoản quản trị</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" name="taiKhoan" class="form-control" value="admin" required autofocus />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" name="matKhau" class="form-control" value="admin123" required />
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Mặc định: tài khoản <code>admin</code> / mật khẩu <code>admin123</code></small>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> ĐĂNG NHẬP HỆ THỐNG
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
