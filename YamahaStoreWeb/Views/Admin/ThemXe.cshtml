@model YamahaStoreWeb.Models.XeMay
@{
    ViewData["Title"] = "Thêm xe máy Yamaha mới";
    Layout = "_Layout";
    var danhMucs = ViewBag.DanhMucs as List<YamahaStoreWeb.Models.DanhMuc> ?? new List<YamahaStoreWeb.Models.DanhMuc>();
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-plus-circle text-danger me-2"></i> THÊM MẪU XE MÁY YAMAHA MỚI</h3>
            <span class="text-muted small">Nhập thông tin sản phẩm xe máy đưa lên hệ thống website</span>
        </div>
        <a asp-action="XeMay" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách xe
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <form asp-action="ThemXe" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Tên mẫu xe <span class="text-danger">*</span></label>
                    <input asp-for="TenXe" class="form-control" placeholder="Ví dụ: Yamaha Exciter 155 VVA 2025" required />
                    <span asp-validation-for="TenXe" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Dòng xe (Danh mục) <span class="text-danger">*</span></label>
                    <select asp-for="MaDanhMuc" class="form-select" required>
                        <option value="">-- Chọn danh mục dòng xe --</option>
                        @foreach (var dm in danhMucs)
                        {
                            <option value="@dm.MaDanhMuc">@dm.TenDanhMuc</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Giá bán đề xuất (VNĐ) <span class="text-danger">*</span></label>
                    <input asp-for="GiaBan" type="number" class="form-control" placeholder="52000000" required />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Giá khuyến mãi (nếu có)</label>
                    <input asp-for="GiaKhuyenMai" type="number" class="form-control" placeholder="50500000" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small">Dung tích xy-lanh (Phân khối) <span class="text-danger">*</span></label>
                    <input asp-for="PhanKhoi" class="form-control" placeholder="155cc / 125cc / Điện" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Các phiên bản màu sắc <span class="text-danger">*</span></label>
                    <input asp-for="MauSac" class="form-control" placeholder="Xanh GP, Đen Nhám, Trắng..." required />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold small">Đường dẫn hình ảnh</label>
                    <input asp-for="HinhAnh" class="form-control" placeholder="/images/products/exciter-155.png" />
                    <small class="text-muted" style="font-size: 0.75rem;">Mặc định: /images/products/exciter-155.png</small>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small">Thông số kỹ thuật chi tiết</label>
                    <textarea asp-for="ThongSoKT" class="form-control" rows="3" placeholder="Động cơ: 155cc; Công suất: 17.7 mã lực; Hệ thống phanh: ABS; Bình xăng: 5.4L..."></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold small">Mô tả chi tiết bài viết</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả phong cách, công nghệ và tính năng ưu việt của xe..."></textarea>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsBanChay" id="switchBanChay">
                        <label class="form-check-label fw-bold text-danger" for="switchBanChay">
                            <i class="bi bi-fire me-1"></i> Đánh dấu là Sản phẩm bán chạy (Mục 2.c - Tiêu chí Khá)
                        </label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch p-3 bg-light rounded-3 border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="IsMoiVe" id="switchMoiVe">
                        <label class="form-check-label fw-bold text-success" for="switchMoiVe">
                            <i class="bi bi-lightning-charge me-1"></i> Đánh dấu là Xe mới về 2025
                        </label>
                    </div>
                </div>

                <div class="col-12 text-end mt-4">
                    <a asp-action="XeMay" class="btn btn-secondary me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger fw-bold px-4">
                        <i class="bi bi-check-circle me-1"></i> Lưu thông tin xe
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
