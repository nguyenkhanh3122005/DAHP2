@model YamahaStoreWeb.Models.TinTuc
@{
    ViewData["Title"] = Model.TieuDe;
    var tinMoi = ViewBag.TinMoi as List<YamahaStoreWeb.Models.TinTuc> ?? new List<YamahaStoreWeb.Models.TinTuc>();
    var danhMucs = ViewBag.DanhMucs as List<YamahaStoreWeb.Models.DanhMuc> ?? new List<YamahaStoreWeb.Models.DanhMuc>();
}

<div class="container">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Tin tức & Khuyến mãi</a></li>
            <li class="breadcrumb-item active">@Model.TieuDe</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                <span class="badge bg-danger mb-2" style="width: fit-content;">BẢN TIN YAMAHA</span>
                <h2 class="fw-bold text-dark mb-2">@Model.TieuDe</h2>
                <div class="text-muted small mb-4 pb-2 border-bottom">
                    <span><i class="bi bi-clock me-1"></i> Ngày đăng: @Model.NgayDang.ToString("dd/MM/yyyy HH:mm")</span> | 
                    <span><i class="bi bi-person me-1"></i> Biên tập: Ban Truyền thông Yamaha Town</span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 font-italic fw-bold text-secondary">
                    @Model.TomTat
                </div>

                <div class="mb-4 text-center">
                    <img src="@Model.HinhAnh" alt="@Model.TieuDe" class="img-fluid rounded-3 shadow-sm w-100"
                         onerror="this.src='https://placehold.co/800x450/0b2265/ffffff?text=Tin+Tuc+Yamaha';" />
                </div>

                <div class="article-content lh-lg" style="font-size: 1.05rem;">
                    @Html.Raw(Model.NoiDung.Replace("\n", "<br/><br/>"))
                </div>

                <div class="mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tin
                    </a>
                    <a asp-controller="DangKy" asp-action="Index" class="btn btn-danger btn-sm">
                        <i class="bi bi-calendar-check me-1"></i> Đăng ký lái thử trải nghiệm
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-fire text-danger me-2"></i> TIN TỨC LIÊN QUAN
                </h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var tin in tinMoi)
                    {
                        <div class="d-flex gap-2 align-items-center">
                            <img src="@tin.HinhAnh" alt="@tin.TieuDe" class="rounded" style="width: 70px; height: 50px; object-fit: cover;"
                                 onerror="this.src='https://placehold.co/70x50/0b2265/ffffff?text=Tin';" />
                            <div class="small">
                                <a asp-action="ChiTiet" asp-route-slug="@tin.Slug" class="text-dark fw-bold text-decoration-none">
                                    @tin.TieuDe
                                </a>
                                <div class="text-muted" style="font-size: 0.75rem;">@tin.NgayDang.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
