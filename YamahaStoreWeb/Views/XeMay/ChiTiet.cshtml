@model YamahaStoreWeb.Models.XeMay
@{
    ViewData["Title"] = Model.TenXe + " - Chi tiết & Giá bán chính hãng";
    var xeLienQuan = ViewBag.XeLienQuan as List<YamahaStoreWeb.Models.XeMay> ?? new List<YamahaStoreWeb.Models.XeMay>();
    var danhMucs = ViewBag.DanhMucs as List<YamahaStoreWeb.Models.DanhMuc> ?? new List<YamahaStoreWeb.Models.DanhMuc>();
    var quangCaos = ViewBag.QuangCaoSidebar as List<YamahaStoreWeb.Models.QuangCao> ?? new List<YamahaStoreWeb.Models.QuangCao>();
}

<div class="container product-detail-container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Dòng xe</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TenXe</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- ================= CỘT TRÁI: MENU DỌC & QUẢNG CÁO ================= -->
        <div class="col-lg-3 col-md-4">
            <!-- Menu Dọc -->
            <div class="menu-doc-card mb-4 bg-white">
                <div class="menu-doc-header d-flex align-items-center">
                    <i class="bi bi-grid-fill me-2 fs-5"></i>
                    <span>DANH MỤC DÒNG XE</span>
                </div>
                <div class="list-group list-group-flush menu-doc-list">
                    @foreach (var dm in danhMucs)
                    {
                        <a asp-action="Index" asp-route-maDanhMuc="@dm.MaDanhMuc" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(Model.MaDanhMuc == dm.MaDanhMuc ? "active" : "")">
                            <span><i class="bi @(string.IsNullOrEmpty(dm.Icon) ? "bi-chevron-right" : dm.Icon) me-2 text-danger"></i> @dm.TenDanhMuc</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Quảng cáo Sidebar -->
            @if (quangCaos.Any())
            {
                <div class="mb-4">
                    @foreach (var qc in quangCaos)
                    {
                        <div class="ad-banner-card mb-3">
                            <a href="@(string.IsNullOrEmpty(qc.LinkLienKet) ? "/DangKy" : qc.LinkLienKet)">
                                <img src="@qc.HinhAnhBanner" alt="@qc.TieuDe" class="img-fluid"
                                     onerror="this.src='https://placehold.co/320x180/0b2265/ffffff?text=@Uri.EscapeDataString(qc.TieuDe)';" />
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ================= CỘT PHẢI: CHI TIẾT SẢN PHẨM ================= -->
        <div class="col-lg-9 col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
                <div class="row g-4">
                    <!-- Ảnh xe lớn -->
                    <div class="col-md-6 text-center">
                        <div class="p-3 bg-light rounded-3 position-relative d-flex align-items-center justify-content-center" style="height: 320px;">
                            @if (Model.IsBanChay)
                            {
                                <span class="badge-banchay position-absolute top-0 start-0 m-3"><i class="bi bi-fire"></i> BÁN CHẠY</span>
                            }
                            <img src="@Model.HinhAnh" alt="@Model.TenXe" class="img-fluid" style="max-height: 260px; object-fit: contain;"
                                 onerror="this.src='https://placehold.co/400x300/f8f9fa/0b2265?text=@Uri.EscapeDataString(Model.TenXe)';" />
                        </div>
                        <div class="d-flex justify-content-around mt-3 small text-muted">
                            <span><i class="bi bi-eye-fill text-primary me-1"></i> @Model.LuotXem lượt xem</span>
                            <span><i class="bi bi-shield-check text-success me-1"></i> Bảo hành 3 năm</span>
                            <span><i class="bi bi-box-seam text-danger me-1"></i> Còn @Model.SoLuongTon xe</span>
                        </div>
                    </div>

                    <!-- Thông tin cơ bản -->
                    <div class="col-md-6">
                        <span class="badge bg-secondary mb-2">@(Model.DanhMuc?.TenDanhMuc ?? "Xe Yamaha")</span>
                        <h3 class="fw-bold text-dark mb-2">@Model.TenXe</h3>
                        
                        <!-- Giá bán -->
                        <div class="p-3 bg-light rounded-3 mb-3">
                            <span class="small text-muted d-block">Giá bán lẻ đề xuất (đã gồm VAT):</span>
                            <div class="d-flex align-items-baseline">
                                <span class="fs-2 fw-bold text-danger">@Model.GiaBan.ToString("N0") VNĐ</span>
                                @if (Model.GiaKhuyenMai.HasValue && Model.GiaKhuyenMai > 0)
                                {
                                    <span class="ms-2 text-decoration-line-through text-muted small">@Model.GiaKhuyenMai.Value.ToString("N0") VNĐ</span>
                                }
                            </div>
                        </div>

                        <!-- Điểm nhấn thông số -->
                        <ul class="list-unstyled mb-4 small">
                            <li class="mb-2"><i class="bi bi-speedometer2 text-danger me-2"></i> <strong>Dung tích xy-lanh:</strong> @Model.PhanKhoi</li>
                            <li class="mb-2"><i class="bi bi-palette text-primary me-2"></i> <strong>Phiên bản màu sắc:</strong> @Model.MauSac</li>
                            <li class="mb-2"><i class="bi bi-patch-check text-success me-2"></i> <strong>Tình trạng:</strong> Xe mới 100% nguyên đai nguyên kiện</li>
                            <li class="mb-2"><i class="bi bi-envelope-check text-info me-2"></i> <strong>Hỗ trợ email:</strong> nguyenkhanh141225@gmail.com</li>
                        </ul>

                        <!-- Nút hành động -->
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="DangKy" asp-action="Index" asp-route-maXe="@Model.MaXe" 
                               class="btn btn-danger py-2 fw-bold d-flex align-items-center justify-content-center">
                                <i class="bi bi-calendar-check me-2 fs-5"></i> ĐĂNG KÝ LÁI THỬ & NHẬN BÁO GIÁ
                            </a>
                            <a href="tel:0982801051" class="btn btn-outline-dark py-2 fw-bold">
                                <i class="bi bi-telephone me-2 text-danger"></i> TƯ VẤN NGAY: 0982 801 051 (MIỄN PHÍ)
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Tabs: Thông số kỹ thuật & Mô tả -->
                <div class="mt-4 pt-4 border-top">
                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-dark" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">
                                <i class="bi bi-cpu-fill text-danger me-1"></i> THÔNG SỐ KỸ THUẬT
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-dark" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">
                                <i class="bi bi-file-text-fill text-primary me-1"></i> ĐẶC ĐIỂM NỔI BẬT
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content p-3 border border-top-0 rounded-bottom bg-light" id="myTabContent">
                        <div class="tab-pane fade show active" id="specs" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped bg-white mb-0" style="font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 0.95rem;">
                                    <tbody>
                                        @if (!string.IsNullOrEmpty(Model.ThongSoKT))
                                        {
                                            foreach (var item in Model.ThongSoKT.Split(';'))
                                            {
                                                if (item.Contains(':'))
                                                {
                                                    var parts = item.Split(':');
                                                    <tr>
                                                        <th style="width: 35%; background-color: #f8fafc;" class="text-secondary fw-semibold">@parts[0].Trim()</th>
                                                        <td class="fw-bold text-dark">@string.Join(":", parts.Skip(1)).Trim()</td>
                                                    </tr>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item))
                                                {
                                                    <tr>
                                                        <td colspan="2" class="fw-semibold">@item.Trim()</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <tr><td>Thông số kỹ thuật tiêu chuẩn của Yamaha Motor Việt Nam.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="desc" role="tabpanel">
                            <div class="p-2" style="font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;">
                                <p class="lead fs-6 mb-3 text-dark lh-base">@Model.MoTa</p>
                                <div class="alert alert-info small mb-0">
                                    <i class="bi bi-info-circle me-1"></i> <strong>Cam kết từ Yamaha Town:</strong> Bảo hành chính hãng 3 năm hoặc 30.000 km. Miễn phí công bảo dưỡng 9 lần định kỳ. Tặng kèm gói phụ kiện trị giá lên đến 1.000.000 VNĐ. Liên hệ tư vấn: <strong>0982 801 051</strong> - Email: <strong>nguyenkhanh141225@gmail.com</strong>.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Xe liên quan -->
            @if (xeLienQuan.Any())
            {
                <div class="mt-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-collection-fill text-danger me-2"></i> DÒNG XE CÙNG PHÂN KHÚC</h5>
                    <div class="row g-3">
                        @foreach (var xe in xeLienQuan)
                        {
                            <div class="col-md-3 col-sm-6">
                                <div class="product-card">
                                    <div class="product-img-wrapper" style="height: 140px;">
                                        <img src="@xe.HinhAnh" alt="@xe.TenXe" style="max-height: 100px;"
                                             onerror="this.src='https://placehold.co/200x120/f1f5f9/0b2265?text=@Uri.EscapeDataString(xe.TenXe)';" />
                                    </div>
                                    <div class="product-body p-2">
                                        <h6 class="product-title" style="font-size: 0.85rem; height: 35px;" title="@xe.TenXe">
                                            <a asp-action="ChiTiet" asp-route-id="@xe.Slug" class="text-dark text-decoration-none">@xe.TenXe</a>
                                        </h6>
                                        <span class="product-price fs-6">@xe.GiaBan.ToString("N0") đ</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
